# Database - PostgreSQL connection (use DATABASE_URL or individual vars)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ballim
DB_USER=
DB_PASSWORD=

# Authentication - REQUIRED in production
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Email - Resend (optional, logs to console if not set)
RESEND_API_KEY=
FROM_EMAIL=noreply@ballim.com
ADMIN_EMAIL=

# Environment
NODE_ENV=development

# Supabase Storage (product images)
# URL otomatik: DATABASE_URL Supabase ise SUPABASE_URL gerekmez
# Sadece secret key zorunlu (Settings > API Keys > Secret veya Legacy service_role)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Alternatif isimler (ikisi de kabul edilir):
# SUPABASE_SECRET_KEY=

# Optional - Vercel
VERCEL_URL=
